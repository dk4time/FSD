# Copy to collector/.env and fill in. This file stays on the trainer's laptop only.
# Atlas: Database -> Connect -> Drivers. Use a user with readWrite on webdev_assessment only.
MONGODB_URI=mongodb+srv://dk0607:dk0607@cluster0.dxpfnen.mongodb.net/?appName=Cluster0&retryWrites=true&w=majority
DB_NAME=webdev_assessment
# Shared with student kits (goes into config.json of the assessment kit). Long and random.
COLLECTOR_KEY=change-me-to-a-long-random-string
# Trainer dashboard (/admin) and trainer --save. Never shared with students.
ADMIN_PASSWORD=change-me-too
# Secret for the per-student PINs (dashboard -> PIN slips). Never shared with students.
# Changing it changes every PIN, so set it once before printing slips.
PIN_SECRET=change-me-to-another-long-random-string
PORT=4000
